/* pages/index/index.wxss */
.header {
  text-align: center;
  margin-bottom: 48rpx;
  padding-top: 48rpx;
}

.title {
  font-size: 56rpx;
  margin-bottom: 24rpx;
  text-shadow: 4rpx 4rpx 8rpx rgba(0, 0, 0, 0.2);
  display: block;
}

.admin-badge {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  background: rgba(78, 205, 196, 0.2);
  color: rgba(78, 205, 196, 1);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.admin-icon-btn {
  position: fixed;
  bottom: 40rpx;
  right: 40rpx;
  padding: 7rpx 5rpx;
  border-radius: 2rpx;
  background: transparent;
  color: white;
  border: none;
  font-size: 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  margin: 0;
  box-sizing: border-box;
}

.admin-icon-btn::after {
  border: none;
}

.admin-menu-content {
  max-width: 500rpx;
}

.admin-menu-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card-title {
  margin: 0;
  color: #374c62;
  font-size: 32rpx;
  font-weight: 600;
}

.empty-state {
  text-align: center;
  padding: 48rpx 24rpx;
  color: #666;
  font-size: 28rpx;
}

.match-info {
  flex: 1;
}

.match-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #374c62;
  display: block;
  margin-bottom: 6rpx;
}

.match-meta {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.public-badge {
  background: rgba(81, 207, 102, 0.2);
  color: rgba(81, 207, 102, 1);
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  font-size: 28rpx;
}

.private-badge {
  background: rgba(255, 107, 107, 0.2);
  color: rgba(255, 107, 107, 1);
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  font-size: 28rpx;
}

.empty-hint {
  display: block;
  margin-top: 12rpx;
  color: #999;
  font-size: 28rpx;
}

.match-actions {
  display: flex;
  gap: 12rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-weight: 600;
  color: #374c62;
  font-size: 28rpx;
}

.form-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
  margin-top: 32rpx;
}

.delete-text {
  margin-bottom: 24rpx;
  color: #666;
  font-size: 28rpx;
  display: block;
}

.delete-warning {
  margin-bottom: 32rpx;
  color: #999;
  font-size: 28rpx;
  display: block;
}

.delete-warning-title {
  margin-bottom: 24rpx;
  color: #ff6b6b;
  font-size: 32rpx;
  font-weight: 600;
  display: block;
}

.delete-warning-red {
  margin-bottom: 32rpx;
  color: #ff6b6b;
  font-size: 28rpx;
  font-weight: 600;
  display: block;
}

.btn-danger {
  background: rgba(255, 107, 107, 0.3);
  border-color: rgba(255, 107, 107, 0.8);
  color: #ff6b6b;
  font-weight: 700;
}
