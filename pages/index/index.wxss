/* pages/index/index.wxss */
.header {
  text-align: center;
  margin-bottom: 80rpx;
  padding-top: 80rpx;
}

.title {
  font-size: 96rpx;
  margin-bottom: 32rpx;
  text-shadow: 4rpx 4rpx 8rpx rgba(0,0,0,0.2);
  display: block;
}

.admin-section {
  margin-top: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
}

.admin-badge {
  background: rgba(78, 205, 196, 0.2);
  color: rgba(78, 205, 196, 1);
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.admin-actions {
  display: flex;
  gap: 16rpx;
}

.card-title {
  margin: 0;
  color: #374c62;
  font-size: 36rpx;
  font-weight: 600;
}

.empty-state {
  text-align: center;
  padding: 80rpx;
  color: #666;
}

.match-info {
  flex: 1;
}

.match-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #374c62;
  display: block;
  margin-bottom: 8rpx;
}

.match-meta {
  font-size: 28rpx;
  color: #666;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.public-badge {
  background: rgba(81, 207, 102, 0.2);
  color: rgba(81, 207, 102, 1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.private-badge {
  background: rgba(255, 107, 107, 0.2);
  color: rgba(255, 107, 107, 1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.empty-hint {
  display: block;
  margin-top: 16rpx;
  color: #999;
  font-size: 24rpx;
}

.match-actions {
  display: flex;
  gap: 16rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  margin-bottom: 16rpx;
  font-weight: 600;
  color: #374c62;
}

.form-actions {
  display: flex;
  gap: 24rpx;
  justify-content: flex-end;
  margin-top: 48rpx;
}

.delete-text {
  margin-bottom: 32rpx;
  color: #666;
  font-size: 32rpx;
  display: block;
}

.delete-warning {
  margin-bottom: 48rpx;
  color: #999;
  font-size: 28rpx;
  display: block;
}

.delete-warning-title {
  margin-bottom: 32rpx;
  color: #ff6b6b;
  font-size: 36rpx;
  font-weight: 600;
  display: block;
}

.delete-warning-red {
  margin-bottom: 48rpx;
  color: #ff6b6b;
  font-size: 28rpx;
  font-weight: 600;
  display: block;
}

.btn-danger {
  background: rgba(255, 107, 107, 0.3);
  border-color: rgba(255, 107, 107, 0.8);
  color: #ff6b6b;
  font-weight: 700;
}

