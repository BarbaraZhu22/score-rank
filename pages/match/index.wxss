/* pages/match/index.wxss */
.match-header {
  margin-bottom: 24rpx;
}

.header-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: fit-content;
  margin-bottom: 12rpx;
}

.refresh-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  min-height: 52rpx;
}

.match-title {
  margin: 0;
  color: #374c62;
  font-size: 32rpx;
  font-weight: 600;
}

.match-meta {
  margin-top: 12rpx;
  color: #666;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.public-badge {
  background: rgba(81, 207, 102, 0.2);
  color: rgba(81, 207, 102, 1);
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  font-size: 28rpx;
}

.private-badge {
  background: rgba(255, 107, 107, 0.2);
  color: rgba(255, 107, 107, 1);
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  font-size: 28rpx;
}

.admin-badge {
  background: rgba(78, 205, 196, 0.2);
  color: rgba(78, 205, 196, 1);
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  font-size: 28rpx;
}
