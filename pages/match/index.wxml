<!--pages/match/index.wxml-->
<view class="container match-detail-page" wx:if="{{matchData}}">
  <view class="match-header">
    <view class="card">
      <view class="flex-between mb-2">
        <text class="match-title">{{matchData.match.name}}
        </text>
        <view class="header-actions">
          <text 
            class="btn btn-outline refresh-btn" 
            bindtap="handleRefresh"
            disabled="{{isRefreshing}}"
          >
            <text wx:if="{{isRefreshing}}" class="loading"></text>{{isRefreshing ? ' 刷新中...' : '🔄 刷新'}}
          </text>
          <text 
            wx:if="{{isAdmin}}"
            class="btn btn-outline" 
            bindtap="handleTogglePublic"
          >{{matchData.match.isPublic ? '🔒 设为私有' : '🌐 设为公开'}}
          </text>
        </view>
      </view>
    </view>
  </view>

  <table-view 
    match-id="{{matchId}}"
    judges="{{matchData.judges}}"
    contestants="{{matchData.contestants}}"
    scores="{{matchData.scores}}"
    contestant-numbers="{{matchData.match.contestantNumbers}}"
    match-name="{{matchData.match.name}}"
    current-version="{{currentVersion}}"
    table-data="{{tableData}}"
    bind:update="loadMatchData"
    bind:refresh="handleRefresh"
  >
  </table-view>

</view>

<view wx:else class="container">
  <view class="card">
    <text>加载中...</text>
  </view>
</view>