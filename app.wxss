/**app.wxss**/
page {
  box-sizing: border-box;
  padding: 0;
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Roboto", "Oxygen",
    "Ubuntu", "Cantarell", "Fira Sans", "Droid Sans", "Helvetica Neue",
    sans-serif;
  font-size: 28rpx;
  background: radial-gradient(
      circle at 20% 50%,
      rgba(138, 43, 226, 0.3) 0%,
      transparent 50%
    ),
    radial-gradient(circle at 80% 80%, rgba(0, 0, 255, 0.3) 0%, transparent 50%),
    radial-gradient(circle at 40% 20%, rgba(0, 128, 0, 0.2) 0%, transparent 50%),
    radial-gradient(
      circle at 60% 60%,
      rgba(255, 215, 0, 0.2) 0%,
      transparent 50%
    ),
    linear-gradient(
      135deg,
      #000000 0%,
      #1a0033 25%,
      #000033 50%,
      #003300 75%,
      #330000 100%
    );
  min-height: 100vh;
  color: #fff;
}

/* 容器 */
.container {
  max-width: 100%;
  margin: 0 auto;
  padding: 24rpx;
}

/* 卡片 */
.card {
  background: rgba(255, 255, 255, 0.66);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1px solid white;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.1) inset;
  backdrop-filter: blur(40rpx);
  color: #374c62;
  margin-bottom: 24rpx;
}

/* 按钮 - 统一基础样式 */
.btn {
  padding: 6rpx 16rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.2);
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(20rpx);
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 统一所有按钮变体的padding和高度 */
.btn-s {
  padding: 6rpx 16rpx;
  font-size: 28rpx;
}

.btn-special {
  padding: 20rpx 20rpx;
  min-height: 52rpx;
  background: linear-gradient(
    135deg,
    #000000 0%,
    #1a0033 25%,
    #000033 50%,
    #003300 75%,
    #330000 100%
  );
  background-size: 200% 200%;
  color: white;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.5),
    inset 0 0 40rpx rgba(138, 43, 226, 0.2),
    inset 0 0 80rpx rgba(0, 0, 255, 0.1);
  border: none;
}

.btn-secondary {
  padding: 6rpx 16rpx;
  background: rgba(78, 205, 196, 0.85);
  border-color: rgba(78, 205, 196, 0.4);
  color: #f8f9fa;
}

.btn-outline {
  padding: 6rpx 16rpx;
  background: transparent;
  border: 2rpx solid #374c62;
  color: #374c62;
}

.btn-non-outline {
  background: transparent;
  color: #f8f9fa;
}

.btn:disabled {
  opacity: 0.5;
}

/* 输入框 */
.input {
  width: 100%;
  padding: 16rpx 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  transition: all 0.3s ease;
  background: white;
  color: #374c62;
}

.input:focus {
  border-color: #000000;
  box-shadow: 0 0 0 6rpx rgba(138, 43, 226, 0.2), 0 0 20rpx rgba(0, 0, 255, 0.2),
    0 0 40rpx rgba(0, 128, 0, 0.1);
}

/* 表格 */
.table-container {
  width: 100%;
  overflow: hidden;
  margin: 24rpx 0;
  position: relative;
}

.table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  background: white;
  border-radius: 12rpx;
  table-layout: auto;
}

.table th,
.table td {
  padding: 16rpx 20rpx;
  text-align: left;
  border-bottom: 2rpx solid #e0e0e0;
  word-wrap: break-word;
  word-break: break-all;
  vertical-align: middle;
}

.table th {
  background: #374c62 !important;
  color: white;
  font-weight: 600;
  text-transform: uppercase;
  font-size: 28rpx;
  letter-spacing: 1rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 4rpx 4rpx -2rpx rgba(0, 0, 0, 0.1);
  white-space: nowrap;
  min-width: 80rpx;
}

.table td {
  font-size: 28rpx;
  min-width: 80rpx;
}

.table tr:hover {
  background: #f5f5f5;
}

.table td.editable {
  position: relative;
}

.table td.empty {
  background: #f8f9fa;
  color: #6c757d;
}

/* 模态框 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  max-width: 600rpx;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
  color: #374c62;
  box-shadow: 0 40rpx 120rpx rgba(0, 0, 0, 0.3);
  margin: 0 auto;
  position: relative;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #374c62;
}

.modal-close {
  background: none;
  border: none;
  font-size: 40rpx;
  color: #999;
  transition: color 0.3s;
}

.modal-close:hover {
  color: #8a2be2;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  bottom: 64rpx;
  right: 64rpx;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(
    135deg,
    #000000 0%,
    #1a0033 25%,
    #000033 50%,
    #003300 75%,
    #330000 100%
  );
  background-size: 200% 200%;
  color: white;
  border: none;
  font-size: 40rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.6), 0 0 60rpx rgba(138, 43, 226, 0.4),
    inset 0 0 40rpx rgba(196, 196, 236, 0.2);
  border: 1px solid rgb(161, 158, 158);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* 列表 */
.list {
  list-style: none;
}

.list-item {
  padding: 16rpx 20rpx;
  background: #f5f5f5;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.list-item:first-child {
  border-top-left-radius: 10rpx;
  border-top-right-radius: 10rpx;
}

/* 工具类 */
.text-center {
  text-align: center;
}

.mt-1 {
  margin-top: 12rpx;
}

.mt-2 {
  margin-top: 24rpx;
}

.mt-3 {
  margin-top: 32rpx;
}

.mb-1 {
  margin-bottom: 12rpx;
}

.mb-2 {
  margin-bottom: 24rpx;
}

.mb-3 {
  margin-bottom: 32rpx;
}

.flex {
  display: flex;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.gap-2 {
  gap: 16rpx;
}

/* 加载动画 */
.loading {
  display: inline-block;
  width: 20rpx;
  height: 20rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  border-top-color: white;
  animation: spin 1s ease-in-out infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 比赛详情页面 */
.match-detail-page {
  font-size: 28rpx;
}

.match-detail-page h2 {
  font-size: 36rpx;
}

.match-detail-page .card {
  font-size: 28rpx;
}

.match-detail-page .btn {
  font-size: 28rpx;
  padding: 6rpx 16rpx;
  min-height: 52rpx;
}

.match-detail-page .btn-s {
  font-size: 28rpx;
  padding: 6rpx 16rpx;
  min-height: 52rpx;
}

.match-detail-page .table {
  font-size: 28rpx;
}

.match-detail-page .table th {
  font-size: 28rpx;
  padding: 16rpx 20rpx;
}

.match-detail-page .table td {
  font-size: 28rpx;
  padding: 16rpx 20rpx;
}

.match-detail-page .modal-content {
  font-size: 28rpx;
}

.match-detail-page .modal-title {
  font-size: 36rpx;
}
